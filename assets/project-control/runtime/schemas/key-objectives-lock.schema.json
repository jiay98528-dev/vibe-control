{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "documentId", "revision", "status", "document", "sourceDocuments", "confirmation", "objectiveIds", "failureModeIds", "nonGoalIds", "lockedAt"],
  "properties": {
    "schemaVersion": {"const": "3.2"},
    "lockId": {"type": "string", "minLength": 1},
    "documentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "CONFIRMED"},
    "document": {"$ref": "#/$defs/ref"},
    "sourceDocuments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "summary", "summarySha256", "record"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "summarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record": {"$ref": "#/$defs/ref"}
      }
    },
    "objectiveIds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^KO-[A-Z0-9][A-Z0-9._-]*$"}},
    "failureModeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^KF-[A-Z0-9][A-Z0-9._-]*$"}},
    "nonGoalIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^NG-[A-Z0-9][A-Z0-9._-]*$"}},
    "lockedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "tracked"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tracked": {"const": true}
      }
    }
  }
}
