{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "taskId", "projectPurpose", "currentGoal", "nodes", "scorecardPlan"],
  "properties": {
    "projectId": {"type": "string", "minLength": 1},
    "taskId": {"type": ["string", "null"]},
    "projectPurpose": {"type": "string", "minLength": 1},
    "currentGoal": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "objectiveRefs", "checkpointRefs", "dependsOn"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "objectiveRefs": {"type": "array", "items": {"type": "string"}},
          "checkpointRefs": {"type": "array", "items": {"type": "string"}},
          "dependsOn": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["PENDING", "ACTIVE", "COMPLETED", "BLOCKED", "FAILED", "SUPERSEDED"]},
          "summary": {"type": "string"}
        }
      }
    },
    "scorecardPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights", "items"],
      "properties": {
        "weights": {"const": {"FUNCTIONALITY": 40, "ROBUSTNESS_SECURITY": 25, "AUDIT": 20, "PROCESS": 15}},
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "statement", "checkpointIds", "factSources"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "category": {"enum": ["FUNCTIONALITY", "ROBUSTNESS_SECURITY", "AUDIT", "PROCESS"]},
              "statement": {"type": "string", "minLength": 1},
              "checkpointIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "factSources": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "refs"],
                  "properties": {
                    "kind": {"enum": ["CHECKPOINT", "CASE", "EVIDENCE", "REVIEW", "CORE_CONTROL"]},
                    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
