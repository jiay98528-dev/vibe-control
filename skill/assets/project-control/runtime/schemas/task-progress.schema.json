{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-progress.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "source", "temporary", "manualClearOnly", "project", "taskBinding",
    "revision", "planSha256", "projectPurpose", "currentGoal", "nodes", "scorecardPlan",
    "events", "report", "reportHistory", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "source": {"const": "LOCAL_TEMPORARY_NON_AUTHORITATIVE"},
    "temporary": {"const": true},
    "manualClearOnly": {"const": true},
    "project": {
      "type": "object",
      "required": ["projectInstanceId", "projectId", "root", "identitySha256"],
      "properties": {
        "projectInstanceId": {"type": "string", "minLength": 1},
        "projectId": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "gitRoot": {"type": ["string", "null"]},
        "gitCommonDir": {"type": ["string", "null"]},
        "identitySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "taskBinding": {
      "type": "object",
      "required": ["taskId"],
      "properties": {"taskId": {"type": ["string", "null"]}}
    },
    "revision": {"type": "integer", "minimum": 0},
    "planSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectPurpose": {"type": "string", "minLength": 1},
    "currentGoal": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "scorecardPlan": {"$ref": "#/$defs/scorecard"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "report": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/report"}]},
    "reportHistory": {"type": "array", "items": {"$ref": "#/$defs/resolvedReport"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "title", "kind", "objectiveRefs", "checkpointRefs", "dependsOn", "status", "summary", "updatedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "objectiveRefs": {"type": "array", "items": {"type": "string"}},
        "checkpointRefs": {"type": "array", "items": {"type": "string"}},
        "dependsOn": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["PENDING", "ACTIVE", "COMPLETED", "BLOCKED", "FAILED", "SUPERSEDED"]},
        "summary": {"type": "string"},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "scorecard": {
      "type": "object",
      "required": ["weights", "items"],
      "properties": {
        "weights": {"const": {"FUNCTIONALITY": 40, "ROBUSTNESS_SECURITY": 25, "AUDIT": 20, "PROCESS": 15}},
        "items": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/scorecardItem"}}
      }
    },
    "scorecardItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "statement", "checkpointIds", "factSources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["FUNCTIONALITY", "ROBUSTNESS_SECURITY", "AUDIT", "PROCESS"]},
        "statement": {"type": "string", "minLength": 1},
        "checkpointIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "factSources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/factSource"}}
      }
    },
    "factSource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "refs"],
      "properties": {
        "kind": {"enum": ["CHECKPOINT", "CASE", "EVIDENCE", "REVIEW", "CORE_CONTROL"]},
        "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "nodeId", "from", "to", "actorId", "sessionId", "at", "summary"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "nodeId": {"type": ["string", "null"]},
        "from": {"type": ["string", "null"]},
        "to": {"type": "string", "minLength": 1},
        "actorId": {"const": "coordinator"},
        "sessionId": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1},
        "failureFingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "contentIdentity": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "stopReason": {"type": ["string", "null"]}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plainLanguage", "nextActions", "stoppedAt", "reason", "reportRevision", "reportSha256"],
      "properties": {
        "plainLanguage": {"$ref": "#/$defs/plainLanguage"},
        "nextActions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/action"}, "allOf": [
          {"contains": {"properties": {"type": {"const": "RECOMMENDED"}}}, "minContains": 1, "maxContains": 1},
          {"contains": {"properties": {"type": {"const": "ALTERNATIVE"}}}, "minContains": 1, "maxContains": 1},
          {"contains": {"properties": {"type": {"const": "OPEN"}}}, "minContains": 1, "maxContains": 1}
        ]},
        "stoppedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "reportRevision": {"type": "integer", "minimum": 1},
        "reportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resolvedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "resolution"],
      "properties": {
        "report": {"$ref": "#/$defs/report"},
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "action", "summary", "acknowledgedAt", "reportRevision", "reportSha256", "recordedAt"],
          "properties": {
            "actorId": {"const": "owner"},
            "action": {"const": "CONTINUE"},
            "summary": {"type": "string", "minLength": 1},
            "acknowledgedAt": {"type": "string", "format": "date-time"},
            "reportRevision": {"type": "integer", "minimum": 1},
            "reportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "recordedAt": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "plainLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPurpose", "whatWasDone", "whatWorksNow", "whatStillDoesNotWork", "userImpact", "canContinue", "canRelease"],
      "properties": {
        "projectPurpose": {"type": "string", "minLength": 1},
        "whatWasDone": {"type": "string", "minLength": 1},
        "whatWorksNow": {"type": "string", "minLength": 1},
        "whatStillDoesNotWork": {"type": "string", "minLength": 1},
        "userImpact": {"type": "string", "minLength": 1},
        "canContinue": {"type": "string", "minLength": 1},
        "canRelease": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "statement", "impact", "risk", "humanEffort", "sourceRefs"],
      "properties": {
        "type": {"enum": ["RECOMMENDED", "ALTERNATIVE", "OPEN"]},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "humanEffort": {"type": "string", "minLength": 1},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
