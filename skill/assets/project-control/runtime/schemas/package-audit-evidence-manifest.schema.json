{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "manifestId", "reportId", "version", "candidateCommit", "candidateTree", "packageManifestSha256", "runtimeManifestSha256", "assuranceMatrixSha256", "auditor", "auditedAt", "counters", "cases"],
  "properties": {
    "schemaVersion": {"const": "3.2"},
    "manifestType": {"const": "vibe-control-package-audit-evidence"},
    "manifestId": {"type": "string", "minLength": 1},
    "reportId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "candidateCommit": {"$ref": "#/$defs/oid"},
    "candidateTree": {"$ref": "#/$defs/oid"},
    "packageManifestSha256": {"$ref": "#/$defs/sha256"},
    "runtimeManifestSha256": {"$ref": "#/$defs/sha256"},
    "assuranceMatrixSha256": {"$ref": "#/$defs/sha256"},
    "auditor": {"$ref": "#/$defs/actor"},
    "auditedAt": {"type": "string", "format": "date-time"},
    "counters": {"$ref": "#/$defs/counters"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["actorId", "sessionId"], "properties": {"actorId": {"type": "string", "minLength": 1}, "sessionId": {"type": "string", "minLength": 1}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["executed", "passed", "failed", "skipped"], "properties": {"executed": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "blob", "sha256", "bytes"], "properties": {"path": {"type": "string", "pattern": "^artifacts/(?!.*\\.\\.)[A-Za-z0-9._/-]+$"}, "blob": {"$ref": "#/$defs/oid"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "command", "startedAt", "finishedAt", "exitCode", "status", "counters", "transcriptPath", "transcriptBlob", "transcriptSha256", "transcriptBytes", "validatedControlIds", "artifacts"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "exitCode": {"const": 0},
        "status": {"const": "PASS"},
        "counters": {"$ref": "#/$defs/counters"},
        "transcriptPath": {"type": "string", "pattern": "^transcripts/[A-Za-z0-9._-]+\\.txt$"},
        "transcriptBlob": {"$ref": "#/$defs/oid"},
        "transcriptSha256": {"$ref": "#/$defs/sha256"},
        "transcriptBytes": {"type": "integer", "minimum": 1},
        "validatedControlIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
