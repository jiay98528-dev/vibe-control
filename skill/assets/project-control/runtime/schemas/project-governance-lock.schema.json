{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "projectId", "packageMode", "packageBinding", "skill", "runtime", "keyObjectives", "caseCatalog", "authorityFiles", "ruleInputs", "positioning", "resolvedRuleSet", "ruleCompiler", "profileDirectory", "adapterDirectory", "skillBindings", "releaseIntent", "trustedKeys", "lockedAt"],
  "properties": {
    "schemaVersion": {"const": "3.2"}, "lockId": {"type": "string"}, "projectId": {"type": "string"},
    "packageMode": {"enum": ["DEVELOPMENT", "SEALED"]},
    "packageBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "packageManifest", "runtimeManifest", "assuranceMatrix"],
      "properties": {
        "version": {"type": "string"}, "sourceKind": {"enum": ["GIT_ROOT", "GIT_SUBDIRECTORY", "PORTABLE_COPY"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "packageManifest": {"$ref": "#/$defs/ref"}, "runtimeManifest": {"$ref": "#/$defs/ref"}, "assuranceMatrix": {"$ref": "#/$defs/ref"}
      }
    },
    "skill": {"$ref": "#/$defs/ref"}, "runtime": {"$ref": "#/$defs/ref"}, "packageAuditReceipt": {"$ref": "#/$defs/ref"},
    "keyObjectives": {"$ref": "#/$defs/ref"}, "automationPolicy": {"$ref": "#/$defs/ref"}, "caseCatalog": {"$ref": "#/$defs/ref"}, "evidenceBytePolicy": {"$ref": "#/$defs/ref"}, "authorityFiles": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "ruleInputs": {"$ref": "#/$defs/ref"}, "positioning": {"$ref": "#/$defs/ref"}, "resolvedRuleSet": {"$ref": "#/$defs/ref"}, "ruleCompiler": {"$ref": "#/$defs/ref"},
    "profileDirectory": {"$ref": "#/$defs/ref"}, "adapterDirectory": {"$ref": "#/$defs/ref"}, "skillBindings": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "releaseIntent": {"enum": ["LOCAL_EXPERIMENT", "PRIVATE_OPERATION", "EXTERNAL_RELEASE"]}, "trustedKeys": {"type": "object"}, "lockedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"packageMode": {"const": "SEALED"}}},
      "then": {
        "required": ["packageAuditReceipt"],
        "properties": {"packageBinding": {"required": ["commit", "tree"]}}
      }
    },
    {
      "if": {
        "properties": {
          "packageMode": {"const": "DEVELOPMENT"},
          "packageBinding": {"properties": {"version": {"enum": ["0.3.5", "0.3.6", "0.3.7"]}}}
        }
      },
      "then": {"properties": {"packageBinding": {"required": ["sourceKind"]}}}
    },
    {
      "if": {"properties": {"packageBinding": {"properties": {"version": {"const": "0.3.7"}}}}},
      "then": {"required": ["evidenceBytePolicy"]}
    },
    {
      "if": {
        "properties": {
          "packageMode": {"const": "DEVELOPMENT"},
          "packageBinding": {"required": ["sourceKind"], "properties": {"sourceKind": {"enum": ["GIT_ROOT", "GIT_SUBDIRECTORY"]}}}
        }
      },
      "then": {"properties": {"packageBinding": {"required": ["commit", "tree"]}}}
    },
    {
      "if": {
        "properties": {
          "packageMode": {"const": "DEVELOPMENT"},
          "packageBinding": {"required": ["sourceKind"], "properties": {"sourceKind": {"const": "PORTABLE_COPY"}}}
        }
      },
      "then": {"properties": {"packageBinding": {"not": {"anyOf": [{"required": ["commit"]}, {"required": ["tree"]}]}}}}
    }
  ],
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "tracked"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "tracked": {"const": true}}}}
}
