{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "primaryExperience", "capabilityDomains", "deliveryObjective", "releaseIntent", "runtimeTargets", "targetEnvironments", "distributionChannels", "humanQualityGates", "nonGoals", "firstVerticalSlice", "confirmation", "keyObjectives", "automationPolicy", "capabilityProfiles", "profileBindings", "runtimeAdapters", "skillBindings", "projectOverlay", "authorityFiles", "trustedKeys", "cases"],
  "properties": {
    "schemaVersion": {"const": "3.2"},
    "projectId": {"type": "string", "minLength": 1},
    "primaryExperience": {"enum": ["GAMEPLAY", "INTERACTIVE_APPLICATION", "SERVICE", "DATA_OR_MODEL_SYSTEM"]},
    "capabilityDomains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["USER_INTERFACE", "REALTIME_ENGINE", "BACKEND_API", "PERSISTENCE", "DATA_PIPELINE", "LLM", "HARDWARE_INTEGRATION"]}},
    "deliveryObjective": {"enum": ["PROTOTYPE", "DEMO", "VERTICAL_SLICE", "PRODUCTION_CANDIDATE"]},
    "releaseIntent": {"enum": ["LOCAL_EXPERIMENT", "PRIVATE_OPERATION", "EXTERNAL_RELEASE"]},
    "runtimeTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "targetEnvironments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "distributionChannels": {"type": "array", "items": {"type": "string"}},
    "humanQualityGates": {"type": "array", "items": {"$ref": "#/$defs/humanGate"}},
    "nonGoals": {"type": "array", "items": {"type": "string"}},
    "firstVerticalSlice": {"type": "object", "additionalProperties": false, "required": ["outcome", "included", "excluded", "successSignals"], "properties": {"outcome": {"type": "string", "minLength": 1}, "included": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}, "successSignals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successSignal"}}}},
    "confirmation": {"$ref": "#/$defs/sourceConfirmation"},
    "keyObjectives": {
      "type": "object", "additionalProperties": false,
      "required": ["document", "documentId", "revision", "status", "sourceDocuments", "objectiveIds", "failureModeIds", "nonGoalIds", "confirmation"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "documentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"const": "CONFIRMED"},
        "sourceDocuments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "objectiveIds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^KO-[A-Z0-9][A-Z0-9._-]*$"}},
        "failureModeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^KF-[A-Z0-9][A-Z0-9._-]*$"}},
        "nonGoalIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^NG-[A-Z0-9][A-Z0-9._-]*$"}},
        "confirmation": {"$ref": "#/$defs/sourceConfirmation"}
      }
    },
    "automationPolicy": {"type": "object"},
    "capabilityProfiles": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "profileBindings": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "runtimeAdapters": {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "object", "required": ["id"]}]}},
    "skillBindings": {"type": "array", "items": {"type": "object", "required": ["id", "required"]}},
    "projectOverlay": {"type": "array", "items": {"type": "object"}},
    "authorityFiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "trustedKeys": {"type": "array", "items": {"type": "object"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "$defs": {
    "successSignal": {"type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": {"id": {"type": "string", "pattern": "^SIG-[0-9a-f]{12}$"}, "statement": {"type": "string", "minLength": 1}}},
    "humanGate": {"type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": {"id": {"type": "string", "pattern": "^HG-[0-9a-f]{12}$"}, "statement": {"type": "string", "minLength": 1}}},
    "sourceConfirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "summary", "summarySha256", "record"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "summarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record": {"type": "string", "minLength": 1}
      }
    }
  }
}
